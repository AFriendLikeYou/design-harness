{
  "Button": "<button class=\"z-ds-button\" data-variant=\"default\" type=\"button\">\n  <span class=\"z-ds-button__label\">Speichern</span>\n</button>",
  "Checkbox": "<div class=\"z-ds-checkbox-field\">\n  <label class=\"z-ds-checkbox\">\n    <input class=\"z-ds-checkbox__box\" type=\"checkbox\">\n    <span class=\"z-ds-checkbox__label\">Auch Angebote der ZEIT erhalten</span>\n  </label>\n  <span class=\"z-ds-checkbox__helper-text\" id=\"checkbox-1-h\" hidden>Abbestellen ist jederzeit möglich.</span>\n</div>",
  "Toggle": "<div class=\"z-ds-toggle-field\">\n  <label class=\"z-ds-toggle\">\n    <button class=\"z-ds-toggle__track\" type=\"button\" role=\"switch\" id=\"toggle-1\" aria-checked=\"false\">\n      <span class=\"z-ds-toggle__thumb\"></span>\n    </button>\n    <span class=\"z-ds-toggle__label\">Was jetzt? Der Morgenüberblick</span>\n  </label>\n  <span class=\"z-ds-toggle__helper-text\" id=\"toggle-1-h\" hidden>Montag bis Freitag um 6 Uhr.</span>\n</div>",
  "Input": "<div class=\"z-ds-input\" data-state=\"default\">\n  <label class=\"z-ds-input__label\" for=\"input-1\">E-Mail-Adresse</label>\n  <div class=\"z-ds-input__control\">\n    <input class=\"z-ds-input__input\" id=\"input-1\" type=\"text\" aria-describedby=\"input-1-h\">\n    <span class=\"z-ds-input__trailing\" hidden></span>\n  </div>\n  <span class=\"z-ds-input__helper-text\" id=\"input-1-h\">Wir schicken dir einen Bestätigungslink.</span>\n  <span class=\"z-ds-input__error-text\" id=\"input-1-e\" hidden>Bitte gib eine gültige E-Mail-Adresse ein.</span>\n</div>",
  "TextButton": "<button class=\"z-ds-text-button\" data-size=\"default\" type=\"button\">\n  <span class=\"z-ds-text-button__label\">Merken</span>\n</button>"
}
