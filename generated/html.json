{
  "Button": "<button class=\"fd-button\" data-variant=\"primary\" data-size=\"md\" type=\"button\">\n  <span class=\"fd-button__label\">Speichern</span>\n</button>",
  "TextField": "<div class=\"fd-text-field\" data-state=\"default\">\n  <label class=\"fd-text-field__label\" for=\"text-field-1\">E-Mail-Adresse</label>\n  <div class=\"fd-text-field__control\">\n    <input class=\"fd-text-field__input\" id=\"text-field-1\" type=\"text\" aria-describedby=\"text-field-1-h\">\n    <span class=\"fd-text-field__trailing\" hidden></span>\n  </div>\n  <span class=\"fd-text-field__helper-text\" id=\"text-field-1-h\">Wir senden dir einen Bestätigungslink.</span>\n  <span class=\"fd-text-field__error-text\" id=\"text-field-1-e\" hidden>Bitte gib eine gültige E-Mail-Adresse ein.</span>\n</div>",
  "Checkbox": "<div class=\"fd-checkbox-field\">\n  <label class=\"fd-checkbox\">\n    <input class=\"fd-checkbox__box\" type=\"checkbox\">\n    <span class=\"fd-checkbox__label\">Angemeldet bleiben</span>\n  </label>\n  <span class=\"fd-checkbox__helper-text\" id=\"checkbox-1-h\" hidden>Du kannst das später ändern.</span>\n</div>",
  "Radio": "<div class=\"fd-radio-field\">\n  <label class=\"fd-radio\">\n    <input class=\"fd-radio__box\" type=\"radio\">\n    <span class=\"fd-radio__label\">Monatlich zahlen</span>\n  </label>\n  <span class=\"fd-radio__helper-text\" id=\"radio-1-h\" hidden>Du kannst jederzeit wechseln.</span>\n</div>",
  "Switch": "<div class=\"fd-switch-field\">\n  <label class=\"fd-switch\">\n    <button class=\"fd-switch__track\" type=\"button\" role=\"switch\" id=\"switch-1\" aria-checked=\"false\">\n      <span class=\"fd-switch__thumb\"></span>\n    </button>\n    <span class=\"fd-switch__label\">E-Mail-Benachrichtigungen</span>\n  </label>\n  <span class=\"fd-switch__helper-text\" id=\"switch-1-h\" hidden>Wir schreiben dir höchstens einmal pro Woche.</span>\n</div>",
  "Chip": "<button class=\"fd-chip\" type=\"button\" aria-pressed=\"false\">\n  <span class=\"fd-chip__label\">Kostenlos</span>\n</button>",
  "Badge": "<span class=\"fd-badge\" data-tone=\"neutral\">\n  <span class=\"fd-badge__label\">Neu</span>\n</span>",
  "Alert": "<div class=\"fd-alert\" data-tone=\"info\" role=\"status\">\n  <p class=\"fd-alert__title\">Änderungen gespeichert</p>\n  <p class=\"fd-alert__description\">Deine Einstellungen gelten ab sofort.</p>\n</div>",
  "Card": "<section class=\"fd-card\">\n  <div class=\"fd-card__header\">\n    <h2 class=\"fd-card__title\">Kartentitel</h2>\n    <span class=\"fd-card__badge\" hidden></span>\n  </div>\n  <p class=\"fd-card__body\">Kurze Beschreibung des Inhalts in ein bis zwei Sätzen.</p>\n  <div class=\"fd-card__footer\" hidden></div>\n</section>",
  "Link": "<a class=\"fd-link\" href=\"#\">\n  <span class=\"fd-link__label\">Alle Rechnungen ansehen</span>\n</a>",
  "SignInForm": "<form class=\"fd-sign-in-form\">\n  <h2 class=\"fd-sign-in-form__title\">Anmelden</h2>\n  <div class=\"fd-text-field\" data-state=\"default\">\n    <label class=\"fd-text-field__label\" for=\"sign-in-form-1\">E-Mail-Adresse</label>\n    <div class=\"fd-text-field__control\">\n      <input class=\"fd-text-field__input\" id=\"sign-in-form-1\" name=\"email\" type=\"email\" autocomplete=\"email\">\n      <span class=\"fd-text-field__trailing\" hidden></span>\n    </div>\n    <span class=\"fd-text-field__helper-text\" id=\"sign-in-form-1-h\" hidden></span>\n    <span class=\"fd-text-field__error-text\" id=\"sign-in-form-1-e\" hidden></span>\n  </div>\n  <div class=\"fd-text-field\" data-state=\"default\">\n    <label class=\"fd-text-field__label\" for=\"sign-in-form-2\">Passwort</label>\n    <div class=\"fd-text-field__control\">\n      <input class=\"fd-text-field__input\" id=\"sign-in-form-2\" name=\"password\" type=\"password\" autocomplete=\"current-password\" aria-describedby=\"sign-in-form-2-h\">\n      <span class=\"fd-text-field__trailing\">\n        <button class=\"fd-button\" data-variant=\"ghost\" data-size=\"sm\" type=\"button\" aria-pressed=\"false\" aria-controls=\"sign-in-form-2\">\n          <span class=\"fd-button__label\">Anzeigen</span>\n        </button>\n      </span>\n    </div>\n    <span class=\"fd-text-field__helper-text\" id=\"sign-in-form-2-h\">Mindestens 12 Zeichen.</span>\n    <span class=\"fd-text-field__error-text\" id=\"sign-in-form-2-e\" hidden></span>\n  </div>\n  <div class=\"fd-checkbox-field\">\n    <label class=\"fd-checkbox\">\n      <input class=\"fd-checkbox__box\" type=\"checkbox\" name=\"remember\">\n      <span class=\"fd-checkbox__label\">Angemeldet bleiben</span>\n    </label>\n    <span class=\"fd-checkbox__helper-text\" id=\"sign-in-form-3-h\" hidden></span>\n  </div>\n  <button class=\"fd-button fd-sign-in-form__submit\" data-variant=\"primary\" data-size=\"md\" type=\"submit\">\n    <span class=\"fd-button__label\">Anmelden</span>\n  </button>\n</form>",
  "ConfirmAction": "<div class=\"fd-confirm-action\">\n  <div class=\"fd-text-field\" data-state=\"default\">\n    <label class=\"fd-text-field__label\" for=\"confirm-action-1\">Gib zur Bestätigung LÖSCHEN ein</label>\n    <div class=\"fd-text-field__control\">\n      <input class=\"fd-text-field__input\" id=\"confirm-action-1\" autocomplete=\"off\" aria-describedby=\"confirm-action-1-h\" type=\"text\">\n      <span class=\"fd-text-field__trailing\" hidden></span>\n    </div>\n    <span class=\"fd-text-field__helper-text\" id=\"confirm-action-1-h\">Der Button wird aktiv, sobald die Eingabe stimmt.</span>\n    <span class=\"fd-text-field__error-text\" id=\"confirm-action-1-e\" hidden></span>\n  </div>\n  <button class=\"fd-button\" data-variant=\"danger\" data-size=\"md\" disabled=\"\" type=\"button\">\n    <span class=\"fd-button__label\">Konto endgültig löschen</span>\n  </button>\n</div>"
}
