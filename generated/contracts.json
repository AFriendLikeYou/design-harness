  "components": {
    "Button": {
      "class": "fd-button",
      "kind": "component",
      "status": "stable",
      "version": "1.4.1",
      "purpose": "Löst eine Aktion aus. Für Navigation zu einer anderen Seite einen Link verwenden.",
      "deprecated": null,
      "booleans": [
        "disabled"
      ],
      "attributes": {
        "data-variant": {
          "values": [
            "primary",
            "secondary",
            "ghost",
            "danger"
          ],
          "default": "primary"
        },
        "data-size": {
          "values": [
            "md",
            "sm"
          ],
          "default": "md"
        },
        "data-state": {
          "values": [
            "default",
            "hover",
            "focus"
          ],
          "default": "default"
        }
      },
      "parts": [
        "fd-button__label"
      ],
      "styles": {
        "variant=primary": {
          "bg": "action/primary",
          "fg": "text/on-action"
        },
        "variant=primary, state=hover": {
          "bg": "action/primary-hover"
        },
        "variant=secondary": {
          "bg": "bg/surface",
          "fg": "text/primary",
          "border": "border/input",
          "borderWidth": "default"
        },
        "variant=secondary, state=hover": {
          "bg": "bg/subtle"
        },
        "variant=ghost": {
          "fg": "feedback/info-fg"
        },
        "variant=ghost, state=hover": {
          "bg": "bg/subtle"
        },
        "variant=danger": {
          "bg": "action/danger",
          "fg": "text/on-action"
        },
        "variant=danger, state=hover": {
          "bg": "action/danger-hover"
        },
        "state=focus": {
          "ring": "focus/ring",
          "ringWidth": "strong"
        },
        "disabled=true": {
          "bg": "bg/disabled",
          "fg": "text/disabled"
        }
      },
      "colorTokens": [
        "--fd-color-action-primary",
        "--fd-color-text-on-action",
        "--fd-color-action-primary-hover",
        "--fd-color-bg-surface",
        "--fd-color-text-primary",
        "--fd-color-border-input",
        "--fd-color-bg-subtle",
        "--fd-color-feedback-info-fg",
        "--fd-color-action-danger",
        "--fd-color-action-danger-hover",
        "--fd-color-focus-ring",
        "--fd-color-bg-disabled",
        "--fd-color-text-disabled"
      ],
      "slots": [],
      "rules": [
        {
          "id": "button/one-primary",
          "text": "Höchstens ein primärer Button pro Ansicht; ein danger-Button und ConfirmAction zählen als primär.",
          "why": "Mehrere primäre Aktionen konkurrieren um Aufmerksamkeit.",
          "check": "max-per-view"
        },
        {
          "id": "button/label-verb",
          "text": "Beschriftung beginnt mit einem Verb und nennt das Ergebnis.",
          "why": "Nutzer:innen wissen vor dem Klick, was passiert.",
          "check": null
        },
        {
          "id": "button/no-custom-colors",
          "text": "Farbe nur über variant, nie eigene Füllungen.",
          "why": "Sonst brechen Dark Mode und Kontrastgarantie.",
          "check": "no-raw-color"
        },
        {
          "id": "button/states-from-system",
          "text": "Hover und Fokus kommen aus der Komponente, nie selbst gestaltet.",
          "why": "Der Fokusring ist eine Zusage an Tastaturnutzer:innen und muss überall gleich aussehen.",
          "check": null
        },
        {
          "id": "button/danger-confirm",
          "text": "variant=danger nur für Aktionen, die etwas unwiderruflich löschen oder beenden, und nie als einzige Absicherung.",
          "why": "Rot warnt, schützt aber nicht vor einem versehentlichen Klick; es braucht zusätzlich eine Bestätigung.",
          "check": null
        }
      ],
      "a11y": "Immer als <button> umsetzen. Deaktiviert nur, wenn ein Hinweis erklärt, warum.",
      "element": "fd-button",
      "attrs": {
        "variant": {
          "type": "enum",
          "values": [
            "primary",
            "secondary",
            "ghost",
            "danger"
          ],
          "default": "primary"
        },
        "size": {
          "type": "enum",
          "values": [
            "md",
            "sm"
          ],
          "default": "md"
        },
        "disabled": {
          "type": "boolean",
          "default": false
        },
        "state": {
          "type": "enum",
          "values": [
            "default",
            "hover",
            "focus"
          ],
          "default": "default"
        },
        "label": {
          "type": "text",
          "default": "Speichern"
        }
      },
      "passthrough": [
        "type",
        "name",
        "value"
      ],
      "slotNames": []
